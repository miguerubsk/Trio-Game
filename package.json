{
  "name": "trio-game",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Trio: a private multiplayer web version of Kaya Miyano's card game",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev -w @trio/server\" \"npm run dev -w @trio/client\"",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "dev:server": "npm run dev -w @trio/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.19.43",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.1"
  }
}
